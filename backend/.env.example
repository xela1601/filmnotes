# Copy to backend/.env on the server and fill in. Never commit the real .env.

# Exactly 32 characters, used to encrypt the PocketBase settings table at rest.
# Generate with: openssl rand -hex 16
# Only takes effect once the `command:` block in docker-compose.yml is uncommented.
PB_ENCRYPTION_KEY=

# The superuser (admin UI) account, used once by the bootstrap command in README.md:
#   docker compose run --rm filmnotes-pb /pb/pocketbase superuser upsert "$PB_ADMIN_EMAIL" "$PB_ADMIN_PASSWORD" --dir /pb/pb_data
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
