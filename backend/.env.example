# Server-side half of the repository-root .env.example - copy that section here on the
# machine that runs PocketBase. Never commit the real .env.
#
#   cp .env.example .env && $EDITOR .env
#   docker compose up -d --build

# The superuser (admin UI) account, used once by the bootstrap command in README.md:
#   docker compose run --rm filmnotes-pb /pb/pocketbase superuser upsert "$PB_ADMIN_EMAIL" "$PB_ADMIN_PASSWORD" --dir /pb/pb_data
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# Exactly 32 characters, used to encrypt the PocketBase settings table at rest.
# Generate with: openssl rand -hex 16
# Only takes effect once the `command:` block in compose.yaml is uncommented.
PB_ENCRYPTION_KEY=
